    {
      "id": "integration-message-journal",
      "approvalState": "engineering-default",
      "startsAt": "message-created",
      "endsAt": "message-journal-retention-completed",
      "legalHoldBehavior": "no-payload-hold"
    },
    {
      "id": "property-governance-revision-lifecycle",
      "approvalState": "engineering-default",
      "startsAt": "property-governance-decision-recorded",
      "endsAt": "tenant-termination-or-approved-pseudonymization",
      "legalHoldBehavior": "retain-minimum-required-audit-evidence"
    },
    {
      "id": "properties-tenant-termination-export-fragment",
      "approvalState": "engineering-default",
      "startsAt": "tenant-export-fragment-generation",
      "endsAt": "tenant-export-artifact-expiry-or-deletion",
      "legalHoldBehavior": "retain-only-with-authorized-tenant-export-artifact"
    },
    {
      "id": "properties-tenant-destruction-proof",
      "approvalState": "engineering-default",
      "startsAt": "approved-properties-tenant-destruction-started",
      "endsAt": "approved-minimum-termination-proof-retention-completed",
      "legalHoldBehavior": "retain-minimum-required-termination-proof"
    },
    {
      "id": "transient-domain-event",
      "approvalState": "engineering-default",
      "startsAt": "domain-event-raised",
      "endsAt": "domain-event-dispatched",
      "legalHoldBehavior": "not-applicable"
    },
    {
      "id": "transient-request",
      "approvalState": "engineering-default",
      "startsAt": "request-accepted",
      "endsAt": "request-completed",
      "legalHoldBehavior": "not-applicable"
    }
  ],
  "rightsPolicies": [
    {
      "id": "authorization-subject",
      "export": "not-retained-by-properties",
      "correction": "correct-through-authoritative-auth-workflow",
      "restriction": "deny-property-access-when-subject-access-is-restricted",
      "erasure": "not-retained-by-properties"
    },
    {
      "id": "staff-audit-attribution",
      "export": "include-in-authorized-staff-audit-or-tenant-export",
      "correction": "append-corrective-property-lifecycle-action",
      "restriction": "retain-minimum-required-audit-and-notification-processing",
      "erasure": "pseudonymize-subject-when-approved-retention-permits"
    },
    {
      "id": "properties-tenant-destruction-proof-control",
      "export": "include-in-authorized-tenant-termination-audit",
      "correction": "append-a-corrective-control-plane-record",
      "restriction": "retain-only-the-minimum-owner-proof",
      "erasure": "remove-after-approved-proof-retention"
    }
  ],
